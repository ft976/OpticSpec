# OPENROUTER_API_KEY: Used to call Google Vision-Language Models on OpenRouter
# (google/gemma-3-27b-it:free, google/gemini-2.0-flash-exp:free, google/gemma-3-12b-it:free, google/gemma-3-4b-it:free).
# Configure this in the AI Studio Settings > Secrets panel.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GEMINI_API_KEY: Automatically injected at runtime by AI Studio for Google Gemini Vision models.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
